# App Configuration
APP_NAME=RevBack
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (Default: local SQLite with async driver; Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./revback.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/revback

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# LLM Providers & Routing
MOCK_LLM_MODE=true
GEMINI_API_KEY=
FAST_MODEL=gemini/gemini-3.1-flash-lite
REASONING_MODEL=gemini/gemini-3.1-flash-lite
LEGAL_MODEL=gemini/gemini-3.1-flash-lite
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
